# Copy to .env.local and fill in what you have. Everything is optional;
# blank values are treated as "not provided" and the UI adapts honestly.

# Public origin of the deployed site (no trailing slash). Used for metadata
# and as the base of the QR code link.
NEXT_PUBLIC_SITE_URL=

# Override the QR code destination entirely (defaults to <site>/guide).
NEXT_PUBLIC_QR_TARGET_URL=

# Official logo file placed in /public/brand (e.g. /brand/wildwoods-logo.svg).
NEXT_PUBLIC_LOGO_SRC=

# Official social profiles (full URLs). Blank = shown as "coming soon".
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# Visitor contact details. Blank = not shown.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Official policy URLs. Blank = link to the local placeholder pages under /legal.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_ACCESSIBILITY_URL=

# Map tiles. Defaults to OpenStreetMap's community server (fine for previews,
# not for production traffic). Use a keyed provider before launch, e.g.
# https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Newsletter provider webhook (server-side only). Without it, sign-ups are
# validated but not stored, and the UI says so.
NEWSLETTER_WEBHOOK_URL=
